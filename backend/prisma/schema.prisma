generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  provider    String   @default("demo")
  providerId  String?  @map("provider_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  pet                Pet?
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  focusSessions      FocusSession[]
  streak             UserStreak?
  dailyTasks         UserDailyTask[]
  dailyMilestones    UserDailyMilestone[]
  inventory          UserInventory[]
  activityEvents     ActivityEvent[]
  notifications      Notification[]
  settings           UserSettings?
  subscription       Subscription?

  @@map("users")
}

model UserSettings {
  userId           String   @id @map("user_id") @db.Uuid
  soundEnabled     Boolean  @default(true) @map("sound_enabled")
  vibrationEnabled Boolean  @default(true) @map("vibration_enabled")
  focusReminders   Boolean  @default(true) @map("focus_reminders")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Subscription {
  userId    String    @id @map("user_id") @db.Uuid
  plan      String    @default("free")
  status    String    @default("active")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Pet {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  name          String
  species       String
  level         Int      @default(1)
  exp           Int      @default(0)
  expToNext     Int      @default(100) @map("exp_to_next")
  hunger        Int      @default(72)
  energy        Int      @default(80)
  mood          Int      @default(76)
  love          Int      @default(68)
  lastUpdatedAt DateTime @default(now()) @map("last_updated_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pets")
}

model Wallet {
  userId    String   @id @map("user_id") @db.Uuid
  tokens    Int      @default(1234)
  energy    Int      @default(5000)
  diamonds  Int      @default(20)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  currency  String
  amount    Int
  reason    String
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model FocusSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  label          String
  plannedMinutes Int       @map("planned_minutes")
  actualSeconds  Int       @default(0) @map("actual_seconds")
  status         String
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model UserStreak {
  userId        String    @id @map("user_id") @db.Uuid
  currentStreak Int       @default(0) @map("current_streak")
  bestStreak    Int       @default(0) @map("best_streak")
  lastFocusDate DateTime? @map("last_focus_date") @db.Date
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model TaskTemplate {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  title          String
  description    String
  taskType       String          @map("task_type")
  targetValue    Int             @map("target_value")
  rewardTokens   Int             @default(0) @map("reward_tokens")
  rewardDiamonds Int             @default(0) @map("reward_diamonds")
  rewardPoints   Int             @default(0) @map("reward_points")
  isActive       Boolean         @default(true) @map("is_active")
  dailyTasks     UserDailyTask[]

  @@map("task_templates")
}

model UserDailyTask {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  taskDate      DateTime  @map("task_date") @db.Date
  progressValue Int       @default(0) @map("progress_value")
  targetValue   Int       @map("target_value")
  status        String    @default("active")
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([userId, templateId, taskDate])
  @@index([userId, taskDate])
  @@map("user_daily_tasks")
}

model DailyMilestone {
  id             String               @id @default(uuid()) @db.Uuid
  pointsRequired Int                  @unique @map("points_required")
  rewardTokens   Int                  @default(0) @map("reward_tokens")
  rewardDiamonds Int                  @default(0) @map("reward_diamonds")
  isActive       Boolean              @default(true) @map("is_active")
  userMilestones UserDailyMilestone[]

  @@map("daily_milestones")
}

model UserDailyMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  milestoneId String    @map("milestone_id") @db.Uuid
  taskDate    DateTime  @map("task_date") @db.Date
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone DailyMilestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@unique([userId, milestoneId, taskDate])
  @@map("user_daily_milestones")
}

model ShopItem {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  emoji       String
  itemType    String          @map("item_type")
  priceTokens Int             @map("price_tokens")
  effectType  String          @map("effect_type")
  effectValue Int             @map("effect_value")
  isHot       Boolean         @default(false) @map("is_hot")
  isActive    Boolean         @default(true) @map("is_active")
  inventory   UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  shopItemId String   @map("shop_item_id") @db.Uuid
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Restrict)

  @@unique([userId, shopItemId])
  @@map("user_inventory")
}

model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type")
  title     String
  subtitle  String
  icon      String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_events")
}

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  notificationType String   @map("notification_type")
  title            String?
  message          String
  icon             String
  isRead           Boolean  @default(false) @map("is_read")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
