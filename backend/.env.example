DATABASE_URL="postgresql://zenzoo:zenzoo_dev@localhost:5432/zenzoo?schema=public"
# On Neon/production append ?sslmode=require to DATABASE_URL.
PORT=3000
CORS_ORIGIN=*

# Auth (JWT) — REQUIRED in production. Use long random strings (openssl rand -hex 32).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional TTL overrides
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30

# Google Sign-In (web client ID from Google Cloud console)
GOOGLE_WEB_CLIENT_ID=

# Admin console login. Defaults to admin@zenzoo.app / zenzoo-admin when unset —
# ALWAYS override these in production. ADMIN_JWT_SECRET falls back to JWT_ACCESS_SECRET.
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables the AI Focus Designer (Gemini Flash). Without it, the app
# falls back to the built-in rule-based focus planner. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# VNPay checkout (optional — endpoints return 500 if hit while unset)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public URL VNPay redirects back to, e.g. https://<your-host>/payments/vnpay/return
VNP_RETURN_URL=
# VNP_FRONTEND_RETURN_URL=
# VNP_ENABLE_RETURN_CONFIRMATION=false

# VietQR bank-transfer payment (manual admin confirm). BIN is the Napas bank code.
VIETQR_BANK_BIN=970426
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_BANK_NAME=MSB
